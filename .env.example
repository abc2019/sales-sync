# Yangi, ALOHIDA Telegram bot (faqat reaksiya kuzatish uchun, buyurtma
# guruhiga admin/a'zo sifatida qo'shiladi). @BotFather'dan oling.
SALES_BOT_TOKEN=123456:your-new-bot-token

# Buyurtma guruhining Telegram chat ID'si (manfiy son, masalan -1001234567890).
# Guruhga biror xabar yuboring va bot API/log orqali chat_id'ni aniqlang.
SALES_GROUP_CHAT_ID=-1001234567890

# Analytics'ning Postgres bazasiga FAQAT O'QISH huquqli ulanish
# (alohida, faqat SELECT huquqli DB foydalanuvchisi bilan tavsiya etiladi).
ANALYTICS_DATABASE_URL=postgresql://sales_sync_ro:CHANGE_ME@host:5432/analytics_db

# Ombor moduli API manzili.
OMBOR_API_BASE_URL=https://your-ombor-domain.up.railway.app
OMBOR_ACTOR_NAME=sales-sync

# Analytics'ning qat'iy mahsulot kodlari -> Ombor external_code xaritasi.
# Analytics'dagi to'liq ro'yxat: palov, mol_tushonka, qoy_tushonka,
# tovuq_tushonka, dimlama, dolma, noxatshorak, moshkichiri, mastava,
# shorva, spagetti, grechka, biryani, tovuq_karri, uygur_lagmon,
# qozon_kabob, qayla, non. Faqat Ombor'da mavjud (external_code berilgan)
# mahsulotlarni kiriting — qolganlari avtomatik "review kerak" bo'ladi.
PRODUCT_CODE_MAP={"palov": "PALOV_ANDIJON", "dimlama": "DIMLAMA_1KG"}

STATE_DATABASE_PATH=sales_sync_state.db
